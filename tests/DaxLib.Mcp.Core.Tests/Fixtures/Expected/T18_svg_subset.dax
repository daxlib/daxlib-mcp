DEFINE
    // Wraps content in SVG container for Power BI visualization
    // @param {string} width – width (pixels or percentage)
    // @param {string} height – height (pixels or percentage)
    // @param {string} contents – To include one or more SVG elements (e.g., from DaxLib.SVG.Element functions)
    // @param {string} [viewbox] – Optional: viewBox (e.g., "0 0 100 100")
    // @param {numeric} [sortValue] – Optional: Sort value for ordering in tables
    // @returns {string} SVG string
    FUNCTION DaxLib.SVG.SVG =
        (
        	width : STRING,
        	height : STRING,
        	contents : STRING,
        	viewbox : STRING = BLANK(),
        	sortValue : NUMERIC = BLANK()
        ) =>
        
        	"data:image/svg+xml;utf8," &
        	"<svg " &
        	"width='" & width & "' height='" & height & "' " &
        	IF( NOT ISBLANK( viewbox ), "viewBox='" & viewbox & "' " ) &
        	"xmlns='http://www.w3.org/2000/svg'>" &
        	IF( NOT ISBLANK( sortValue ), "<desc>" & FORMAT( sortValue, "000000000000" ) & "</desc>" ) &
        	contents &
        	"</svg>"
    // Generates a STRING of common shape attributes that can be passed to `DaxLib.SVG.Element.*` or `DaxLib.SVG.Def.*` functions
    // @param {string} [fill] – Fill color or gradient reference. Omitted if not specified
    // @param {decimal} [fillOpacity] – Fill opacity (0-1). Omitted if not specified
    // @param {string} [fillRule] – Fill rule ("nonzero" or "evenodd"). Omitted if not specified
    // @param {string} [stroke] – Stroke color. Omitted if not specified
    // @param {int} [strokeWidth] – Stroke width. Omitted if not specified
    // @param {decimal} [strokeOpacity] – Stroke opacity (0-1). Omitted if not specified
    // @param {decimal} [opacity] – Overall opacity (0-1). Omitted if not specified
    // @returns {string} An attribute string that can be used directly in SVG elements
    FUNCTION DaxLib.SVG.Attr.Shapes =
        (
        	fill: STRING = BLANK(),
        	fillOpacity: DOUBLE = BLANK(),
        	fillRule: STRING = BLANK(),
        	stroke: STRING = BLANK(),
        	strokeWidth: INT64 = BLANK(),
        	strokeOpacity: DOUBLE = BLANK(),
        	opacity: DOUBLE = BLANK()
        ) =>
        
        	IF( NOT ISBLANK( fill ),          "fill='" & fill & "' ") &
        	IF( NOT ISBLANK( fillOpacity ),   "fill-opacity='" & fillOpacity & "' ") &
        	IF( NOT ISBLANK( fillRule ),      "fill-rule='" & fillRule & "' ") &
        	IF( NOT ISBLANK( stroke ),        "stroke='" & stroke & "' ") &
        	IF( NOT ISBLANK( strokeWidth ),   "stroke-width='" & strokeWidth & "' ") &
        	IF( NOT ISBLANK( strokeOpacity ), "stroke-opacity='" & strokeOpacity & "' ") &
        	IF( NOT ISBLANK( opacity ),       "opacity='" & opacity & "' ")
    // Text-specific attributes
    // @param {string} [fontFamily] – Font family for text. Omitted if not specified
    // @param {int} [fontSize] – Font size for text. Omitted if not specified
    // @param {string} [fontWeight] – Weight ("normal", "bold", "lighter", "100-900"). Omitted if not specified
    // @param {string} [fontStyle] – Style ("normal", "italic", "oblique"). Omitted if not specified
    // @param {string} [textAnchor] – Anchor ("start", "middle", "end"). Omitted if not specified
    // @param {string} [baseline] – Dominant baseline. Omitted if not specified
    // @param {string} [textDecoration] – Decoration ("none", "underline", "overline", "line-through"). Omitted if not specified
    // @param {string} [letterSpacing] – Space between letters. Omitted if not specified
    // @param {string} [wordSpacing] – Space between words. Omitted if not specified
    // @returns {string} An attribute string that can be used directly in SVG text elements
    FUNCTION DaxLib.SVG.Attr.Txt =
        (
        	fontFamily: STRING = BLANK(),
        	fontSize: INT64 = BLANK(),
        	fontWeight: STRING = BLANK(),
        	fontStyle: STRING = BLANK(),
        	textAnchor: STRING = BLANK(),
        	baseline: STRING = BLANK(),
        	textDecoration: STRING = BLANK(),
        	letterSpacing: STRING = BLANK(),
        	wordSpacing: STRING = BLANK()
        ) =>
        
        	IF( NOT ISBLANK( fontFamily ),     "font-family='" & fontFamily & "' ") &
        	IF( NOT ISBLANK( fontSize ),       "font-size='" & fontSize & "' ") &
        	IF( NOT ISBLANK( fontWeight ),     "font-weight='" & fontWeight & "' ") &
        	IF( NOT ISBLANK( fontStyle ),      "font-style='" & fontStyle & "' ") &
        	IF( NOT ISBLANK( textAnchor ),     "text-anchor='" & textAnchor & "' ") &
        	IF( NOT ISBLANK( baseline ),       "dominant-baseline='" & baseline & "' ") &
        	IF( NOT ISBLANK( textDecoration ), "text-decoration='" & textDecoration & "' ") &
        	IF( NOT ISBLANK( letterSpacing ),  "letter-spacing='" & letterSpacing & "' ") &
        	IF( NOT ISBLANK( wordSpacing ),    "word-spacing='" & wordSpacing & "' ")
    // Creates a text SVG element
    // @param {string} x – The x position of the text
    // @param {string} y – The y position of the text
    // @param {string} txt – The text content
    // @param {string} [dx] – Optional: x offset from position
    // @param {string} [dy] – Optional: y offset from position
    // @param {string} [attributes] – Optional: Direct SVG attributes to apply (e.g., "text-anchor='middle' dominant-baseline='middle'"), can generate with `DaxLib.SVG.Attr.*` or manually
    // @param {string} [transforms] – Optional: Additional transforms (e.g. "scale(1.2) translate(10,10)") (can be generated with `DaxLib.SVG.Transforms`)
    // @param {boolean} [escape] – Optional: When TRUE or BLANK (default), XML-escapes `txt` (replaces &, <, >, ", ') so characters like & and < render correctly. Pass FALSE to insert `txt` verbatim (e.g. when it already contains raw SVG markup).
    // @returns {string} <text> element
    FUNCTION DaxLib.SVG.Element.Txt =
        (
        	x: STRING,
        	y: STRING,
        	txt: STRING,
        	dx: STRING = BLANK(),
        	dy: STRING = BLANK(),
        	attributes: STRING = BLANK(),
        	transforms: STRING = BLANK(),
        	escape: BOOLEAN = TRUE()
        ) =>
        
        	VAR _Escape = COALESCE( escape, TRUE() )
        	VAR _s0 = COALESCE( txt, "" )
        	VAR _s1 = SUBSTITUTE( _s0, "&",  "&amp;"  )
        	VAR _s2 = SUBSTITUTE( _s1, "<",  "&lt;"   )
        	VAR _s3 = SUBSTITUTE( _s2, ">",  "&gt;"   )
        	VAR _s4 = SUBSTITUTE( _s3, """", "&quot;" )
        	VAR _s5 = SUBSTITUTE( _s4, "'",  "&apos;" )
        	VAR _Txt = IF( _Escape, _s5, txt )
        	RETURN
        		"<text" &
        		" x='" & x & "'" &
        		" y='" & y & "'" &
        		IF(NOT ISBLANK( dx ), " dx='" & dx & "'" ) &
        		IF(NOT ISBLANK( dy ), " dy='" & dy & "'" ) &
        		IF( NOT ISBLANK( attributes ), " " & attributes & " " ) &
        		IF( NOT ISBLANK( transforms ), " transform='" & transforms & "'" ) &
        		">" & _Txt &
        		"</text>"
    // Generates a rectangle SVG element
    // @param {string} x – The x position
    // @param {string} y – The y position
    // @param {string} width – The width (pixels or percentage)
    // @param {string} height – The height (pixels or percentage)
    // @param {string} [rx] – Optional: x radius for rounded corners
    // @param {string} [ry] – Optional: y radius for rounded corners
    // @param {string} [attributes] – Optional: Direct SVG attributes to apply (e.g., "fill='red' stroke-width='2'"), can generate with `DaxLib.SVG.Attr.*` or manually
    // @param {string} [transforms] – Optional: Transformation to apply (can be generated with `DaxLib.SVG.Transforms`)
    // @returns {string} <rect> element
    FUNCTION DaxLib.SVG.Element.Rect =
        (
        	x: STRING,
        	y: STRING,
        	width: STRING,
        	height: STRING,
        	rx: STRING = BLANK(),
        	ry: STRING = BLANK(),
        	attributes: STRING = BLANK(),
        	transforms: STRING = BLANK()
        ) =>
        
        	"<rect" &
        	" x='" & x & "'" &
        	" y='" & y & "'" &
        	" width='" & width & "'" &
        	" height='" & height & "'" &
        	IF( NOT ISBLANK( rx ), " rx='" & rx & "'" ) &
        	IF( NOT ISBLANK( ry ), " ry='" & ry & "'" ) &
        	IF( NOT ISBLANK( attributes ), " " & attributes & " " ) &
        	IF( NOT ISBLANK( transforms ), " transform='" & transforms & "'" ) &
        	"/>"
    // Create a pill SVG compound (rounded rectangle with auto-sized text centered inside)
    // @param {int} x – The x position of compound
    // @param {int} y – The y position of compound
    // @param {int} width – The width of the compound
    // @param {int} height – The height of the compound
    // @param {string} txt – The text to display
    // @param {string} [color] – Optional: The hex color of the pill, e.g., "#01B8AA80". Defaults to "#01B8AA"
    // @param {decimal} [paddingX] – Optional: The horizontal padding percentage (0.0-1.0, e.g., 0.1 = 10% padding). Defaults to 0.05
    // @param {decimal} [paddingY] – Optional: The vertical padding percentage (0.0-1.0, e.g., 0.1 = 10% padding). Defaults to 0.02
    // @returns {string} SVG Pill
    FUNCTION DaxLib.SVG.Compound.Pill =
        (
        	x: INT64,
        	y: INT64,
        	width: INT64,
        	height: INT64,
        	txt: STRING,
        	color: STRING = BLANK(),
        	paddingX: DOUBLE = 0.05,
        	paddingY: DOUBLE = 0.02
        ) =>
        
        // Apply padding to dimensions
        VAR _X = 			x + (width * (IF(ISBLANK(paddingX), 0, paddingX) / 2))
        VAR _Y = 			y + (height * (IF(ISBLANK(paddingY), 0, paddingY) / 2))
        VAR _Width = 		width * (1 - IF(ISBLANK(paddingX), 0, paddingX))
        VAR _Height = 		height * (1 - IF(ISBLANK(paddingY), 0, paddingY))
        
        VAR _Color = IF( NOT ISBLANK( color ), color, "#01B8AA" )
        
        VAR _Pill =
        	DaxLib.SVG.Element.Rect(
        		_X,
        		_Y,
        		_Width * 0.98,
        		_Height * 0.92,
        		10,
        		10,
        		DaxLib.SVG.Attr.Shapes(
        			_Color,
        			0.2,
        			BLANK(),
        			_Color,
        			1
        		)
        	)
        
        // Auto-size font to fit text within pill
        VAR _AvailableWidth = _Width * 0.90
        VAR _CharWidthRatio = 0.55
        VAR _TextWidthAtOne = LEN( txt ) * _CharWidthRatio
        VAR _MaxFontFromWidth = IF( _TextWidthAtOne > 0, _AvailableWidth / _TextWidthAtOne, 12 )
        VAR _MaxFontFromHeight = _Height * 0.75
        VAR _FontSize = MAX( 4, MIN( 12, MIN( _MaxFontFromWidth, _MaxFontFromHeight ) ) )
        
        VAR _TextElement =
        	DaxLib.SVG.Element.Txt(
        		_X + (_Width * 0.50),
        		_Y + (_Height * 0.58),
        		txt,
        		0,
        		0,
        		DaxLib.SVG.Attr.Shapes( _Color ) &
        		DaxLib.SVG.Attr.Txt(
        			"Segoe UI",
        			_FontSize,
        			BLANK(),
        			BLANK(),
        			"middle",
        			"middle"
        		)
        	)
        
        VAR _CombinedElements =
        	_Pill &
        	_TextElement
        
        RETURN
        
        	IF( NOT ISBLANK( txt ), _CombinedElements )
    // Creates a ProgressBar compound SVG visual
    // @param {int} x – The x position of the compound
    // @param {int} y – The y position of the compound
    // @param {int} width – The width of the compound
    // @param {int} height – The height of the compound
    // @param {numeric expr} valueRef – Value expression (the bar measure)
    // @param {numeric expr} [trackRef] – Optional: Track measure (maximum value, can vary per context). Defaults to MAX(1, ABS(valueRef))
    // @param {string} [fillColor] – Optional: Progress color. Defaults to "#0F6CBD"
    // @param {string} [trackColor] – Optional: Track color. Defaults to "#E1DFDD"
    // @param {string} [orientation] – "Horizontal" or "Vertical". Defaults to "Horizontal"
    // @param {decimal} [paddingX] – Optional: Horizontal padding percentage (0.0-1.0). Defaults to 0.05
    // @param {decimal} [paddingY] – Optional: Vertical padding percentage (0.0-1.0). Defaults to 0.02
    // @returns {string} SVG Progress Bar
    FUNCTION DaxLib.SVG.Compound.ProgressBar =
        (
        	x: INT64,
        	y: INT64,
        	width: INT64,
        	height: INT64,
        	valueRef: NUMERIC EXPR,
        	trackRef: NUMERIC EXPR = BLANK(),
        	fillColor: STRING = "#0F6CBD",
        	trackColor: STRING = "#E1DFDD",
        	orientation: STRING = "Horizontal",
        	paddingX: DOUBLE = 0.05,
        	paddingY: DOUBLE = 0.02
        ) =>
        
        	VAR _X = x + (width * (IF(ISBLANK(paddingX), 0, paddingX) / 2))
        	VAR _Y = y + (height * (IF(ISBLANK(paddingY), 0, paddingY) / 2))
        	VAR _Width = width * (1 - IF(ISBLANK(paddingX), 0, paddingX))
        	VAR _Height = height * (1 - IF(ISBLANK(paddingY), 0, paddingY))
        
        	VAR _Orientation = IF( orientation = "Vertical", "Vertical", "Horizontal" )
        	VAR _FillColor = IF( NOT ISBLANK( fillColor ), fillColor, "#0F6CBD" )
        	VAR _TrackColor = IF( NOT ISBLANK( trackColor ), trackColor, "#E1DFDD" )
        
        	VAR _Value = valueRef
        	VAR _Max = IF( ISBLANK( trackRef ), MAX( 1, ABS( _Value ) ), MAX( 1, ABS( trackRef ) ) )
        	VAR _Pct = MIN( 1, MAX( 0, DIVIDE( _Value, _Max, 0 ) ) )
        
        	VAR _Track =
        		DaxLib.SVG.Element.Rect(
        			_X,
        			_Y,
        			_Width,
        			_Height,
        			3,
        			3,
        			DaxLib.SVG.Attr.Shapes( _TrackColor, 1, BLANK(), _TrackColor, 1 )
        		)
        
        	VAR _FillW = IF( _Orientation = "Horizontal", _Width * _Pct, _Width )
        	VAR _FillH = IF( _Orientation = "Horizontal", _Height, _Height * _Pct )
        	VAR _FillX = _X
        	VAR _FillY = IF( _Orientation = "Horizontal", _Y, _Y + ( _Height - _FillH ) )
        
        	VAR _Fill =
        		DaxLib.SVG.Element.Rect(
        			_FillX,
        			_FillY,
        			_FillW,
        			_FillH,
        			3,
        			3,
        			DaxLib.SVG.Attr.Shapes( _FillColor, 0.95, BLANK(), _FillColor, 1 )
        		)
        
        	RETURN
        		IF( NOT ISBLANK( _Value ) && _Width > 0 && _Height > 0, _Track & _Fill )
    // Renders a pill-shaped badge as an SVG data URI with centered text
    // @param {string} txt – The text to display
    // @param {string} [color] – Optional pill color. Defaults to Power BI theme color
    // @param {int} [width] – Optional: SVG width. Defaults to 120
    // @param {int} [height] – Optional: SVG height. Defaults to 48
    // @returns {string} SVG Pill
    FUNCTION DaxLib.SVG.Viz.Pill =
        (
        	txt: STRING,
        	color: STRING = BLANK(),
        	width: INT64 = 120,
        	height: INT64 = 48
        ) =>
        
        	VAR _Marks =
        		DaxLib.SVG.Compound.Pill(
        			0,
                          0,
                          width,
                          height,
                          txt,
                          color
        		)
        
        	RETURN
        		IF( NOT ISBLANK( _Marks ), DaxLib.SVG.SVG( "100%", "100%", _Marks, "0 0 " & width & " " & height ) )
    // Renders a progress bar as an SVG data URI showing value progression
    // @param {numeric expr} valueRefExpr – Value expression
    // @param {numeric expr} trackRefExpr – Track measure (maximum value)
    // @param {string} [color] – Optional fill color. Defaults to Power BI theme color
    // @param {string} [orientation] – Optional orientation: "Horizontal" or "Vertical". Defaults to "Horizontal"
    // @param {int} [width] – Optional: SVG width. Defaults to 120
    // @param {int} [height] – Optional: SVG height. Defaults to 48
    // @returns {string} SVG Progress Bar
    FUNCTION DaxLib.SVG.Viz.ProgressBar =
        (
        	valueRefExpr: NUMERIC EXPR,
        	trackRefExpr: NUMERIC EXPR,
        	color: STRING = BLANK(),
        	orientation: STRING = "Horizontal",
        	width: INT64 = 120,
        	height: INT64 = 48
        ) =>
        
        	VAR _Marks =
        		DaxLib.SVG.Compound.ProgressBar(
        			0,
                          0,
                          width,
                          height,
        			valueRefExpr,
                          trackRefExpr,
                          color,
                          "#E1DFDD",
                          orientation
        		)
        
        	RETURN
        		IF( NOT ISBLANK( _Marks ), DaxLib.SVG.SVG( "100%", "100%", _Marks, "0 0 " & width & " " & height ) )
EVALUATE
ADDCOLUMNS ( VALUES ( 'Product'[Category] ),
    "Pill", DaxLib.SVG.Viz.Pill ( 'Product'[Category], "#118DFF" ),
    "Bar", DaxLib.SVG.Viz.ProgressBar ( [Sales Amount], CALCULATE ( [Sales Amount], ALL ( 'Product' ) ) ) )